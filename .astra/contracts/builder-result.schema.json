{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra Builder Result",
  "type": "object",
  "required": ["builder", "filesChanged", "criteriaAddressed", "testsRun", "knownLimitations", "securityDataImplications"],
  "properties": {
    "builder": {"type": "string"},
    "filesChanged": {"type": "array", "items": {"type": "string"}},
    "criteriaAddressed": {"type": "array", "items": {"type": "string"}},
    "testsRun": {"type": "array", "items": {"type": "object", "required": ["command", "result"], "properties": {"command": {"type": "string"}, "result": {"enum": ["pass", "fail", "not_run"]}}, "additionalProperties": true},
    "knownLimitations": {"type": "array", "items": {"type": "string"}},
    "securityDataImplications": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}